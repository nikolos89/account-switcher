  "ui_config": {
    "display_name": "Account Switcher",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Account Switcher"
      }
    ]
  }
}
